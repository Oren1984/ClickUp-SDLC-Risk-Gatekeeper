# ============================================================
# RAG Retrieval Evaluation Lab — Environment Configuration
# Copy this file to .env and fill in values as needed.
# Default values are safe for local mock-mode execution.
# ============================================================

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Mock mode (safe default: no API keys required) ---
MOCK_MODE=true

# --- Embedding provider ---
# Options: mock | huggingface | openai | gemini
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-384

# --- Vector store ---
# Options: chroma | faiss
VECTOR_STORE=chroma

# --- Chunking ---
# Options: recursive | fixed
CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K=5

# --- Re-ranking (optional, disabled by default) ---
USE_RERANKER=false

# --- Optional API keys (leave empty to stay in mock mode) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Paths ---
DATA_DIR=data
VECTOR_DB_DIR=vector_db
RESULTS_DIR=results

# --- Upload limits ---
MAX_UPLOAD_MB=10
